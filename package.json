{
    "name": "nodo",
    "version": "1.0.0",
    "description": "记了么（Nodo）—— 智能笔记 · 待办管理 · AI 智能助手",
    "author": "Nodo",
    "main": "out/main/index.js",
    "type": "commonjs",
    "build": {
        "appId": "com.nodo.app",
        "productName": "记了么",
        "win": {
            "artifactName": "${productName}-${version}-${arch}.${ext}"
        }
    },
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "start": "electron-vite preview",
        "build:win": "electron-vite build && electron-builder --win --x64",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.1",
        "@langchain/core": "^1.2.17",
        "@langchain/langgraph": "^1.5.0",
        "@langchain/langgraph-checkpoint": "^1.2.0",
        "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
        "@langchain/langgraph-sdk": "^1.12.4",
        "@langchain/openai": "^1.6.2",
        "@tavily/core": "^0.6.0",
        "@types/multer": "^2.3.0",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.6",
        "adm-zip": "^0.6.1",
        "axios": "^1.7.9",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "deepagents": "^1.15.0",
        "dompurify": "^3.4.17",
        "dotenv": "^16.4.7",
        "electron-store": "^8.2.0",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "katex": "^0.19.0",
        "langchain": "^1.5.16",
        "langsmith": "^0.7.17",
        "mammoth": "^1.13.0",
        "marked": "^18.1.1",
        "multer": "^2.4.0",
        "mysql2": "^3.11.5",
        "pdf-parse": "^1.1.1",
        "pg": "^8.23.1",
        "pinia": "^2.3.0",
        "pinyin-pro": "^3.29.5",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20",
        "vue": "^3.5.13",
        "vue-i18n": "^9.14.3",
        "vue-router": "^4.5.0",
        "vuedraggable": "^4.1.0",
        "xlsx": "^0.18.5",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.17.10",
        "@vitejs/plugin-vue": "^5.2.1",
        "electron": "^33.2.1",
        "electron-builder": "^25.1.8",
        "electron-vite": "^2.3.0",
        "element-plus": "^2.9.1",
        "sass": "^1.83.0",
        "typescript": "^5.7.2",
        "unplugin-auto-import": "^0.18.6",
        "unplugin-vue-components": "^0.27.5",
        "vite": "^5.4.11",
        "vue-tsc": "^2.1.10"
    }
